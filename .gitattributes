# Все текстовые файлы — LF в рабочей копии при любом core.autocrlf (Windows): с CRLF тесты,
# читающие исходники регулярками, и сверки манифестов расходятся. Правила ниже уточняют это.
* text=auto eol=lf

# Что НЕ попадает в Composer-пакет (git archive соблюдает export-ignore).
#
# Список обязан совпадать со списком KEEP в build.sh, иначе на портал уедет
# разное в зависимости от способа установки. Сверяется автоматически, см.
# build.sh, check_gitattributes.

/.claude/		export-ignore
/.gitattributes		export-ignore
/.github/		export-ignore
/.gitignore		export-ignore
/AGENTS.md		export-ignore
/CLAUDE.md		export-ignore
/CONTRIBUTING.md	export-ignore
/docs/			export-ignore
/build.sh		export-ignore
/changelog/		export-ignore
/tools/			export-ignore
/tests/			export-ignore

# Скрипты — всегда LF: с CRLF sync.sh и build.sh не запускаются.
*.sh		text eol=lf

*.png		binary
*.jpg		binary
*.webp		binary
*.woff2		binary
*.ico		binary
*.gz		binary
*.zip		binary
