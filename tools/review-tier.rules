# Правила уровня ревью shef.toolsaicrm. Формат и движок — tools/review-tier.sh (эталон; в репозитории правят только этот файл).
# Решение владельца 2026-11-07 (bx-shef/toolsai-stand#42). Навык — .claude/skills/review-panel/SKILL.md.
#
# Первое подходящее правило выигрывает: исключения стоят выше общих. Не подошло ничего — уровень 1.
# Уровень PR — наибольший по его файлам. Поднять уровень вручную можно, опустить нельзя.
# Путей «только по слову владельца» (hold) в репозитории нет.

# --- исключения: выше общих правил -----------------------------------------------------------------
hold LICENSE                        # лицензия репозитория — решение владельца
0 .github/pull_request_template.md    # шаблон PR — документ
2 .github/*                           # остальное в .github — CI, и .md тоже: правило стоит выше общего «*.md»
2 .claude/skills/sync.sh|.claude/skills/update.sh   # скрипты сверки навыков, CI зовёт update.sh --verify

# --- уровень 0: без ревью, только ./build.sh --check ----------------------------------------------
0 .gitattributes|.gitignore
0 install/version.php                 # версия модуля
0 .claude/*                           # навыки и их evals; MANIFEST, SOURCE — данные, их сверяют скрипты
0 changelog/*                         # лента «Что нового»
0 docs/*                              # справка, docs/dev, docs/private, карта проекта
0 *.md                                # README, CHANGELOG, CLAUDE, AGENTS, CONTRIBUTING
0 tests/*                             # тесты без кода модуля: уровень задают остальные файлы

# --- уровень 2: двое проверяющих; панель из пяти — только деньги и лицензии ------------------------
2 tools/review-tier.*                 # правила уровней: ошибка в них тихо снижает ревью
2 build.sh|composer.json              # сборка, пакет
2 .settings.php|default_option.php    # подписки, контроллеры, умолчания и коды настроек: смена — решение владельца
# установщик, перенос данных, доведение после обновления копированием
2 install/*
2 lib/main/migration*.php|lib/main/setup.php|lib/main/maintenance.php|lib/main/publicpage.php|lib/main/coremigrationport.php
# ядро анализа: шов к shef.toolsai, прогон, агенты, поля «AI: …» и защита, запись в CRM
2 lib/core/*|lib/container.php|lib/analysis/runner.php|lib/analysis/crmwrite.php|lib/agent/*
2 lib/deal/field/*
# публичный API и безопасность: контроллеры, REST, MCP, ajax и компонент страницы
2 lib/controller/*|lib/integration/rest/*|lib/rest/*
2 settings/ajax.php|settings/component.php
# схема таблиц
2 lib/*/model/*table.php

# --- таблица случаев для --self-test ---------------------------------------------------------------
case 0 README.md
case 0 CHANGELOG.md
case 0 CLAUDE.md
case 0 AGENTS.md
case 0 CONTRIBUTING.md
case 0 docs/README.md
case 0 docs/private/project-map.md
case 0 docs/private/agent-rules.md
